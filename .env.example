# iiko: обязательные значения
IIKO_SERVER=https://your-iiko-host.example/resto
IIKO_LOGIN=replace_me
IIKO_PASSWORD=replace_me
# Основной селектор филиала. Должен совпасть с единственным активным DEPARTMENT.
IIKO_ORG_NAME=Волоколамское шоссе 95/2с8
# Необязательно: UUID того же филиала для дополнительной строгой проверки.
IIKO_ORG_ID=
# Меняйте только если live-каталог /olap/columns подтверждает другое поле.
IIKO_OLAP_DEPARTMENT_FIELD=Department.Id
# Необязательно: путь к корпоративному CA bundle для частного сертификата.
IIKO_CA_BUNDLE=

# Часовой пояс и обновление
APP_TIMEZONE=Europe/Moscow
REPORT_CACHE_TTL_SECONDS=900
REPORT_DAILY_REFRESH_HOUR=23
OPEN_BROWSER=false

# Отчёт оставлен публичным по решению владельца. Для будущего закрытия
# задайте обе переменные HTTP Basic Auth вместе.
REPORT_USERNAME=
REPORT_PASSWORD=

# PostgreSQL: предпочтительно одна строка подключения.
DATABASE_URL=
# Либо отдельные параметры:
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASS=
PGSSLMODE=require

# Google Sheets; оставьте пустыми, если источник не используется.
SCHEDULE_SHEET_ID=
SCHEDULE_SHEET_GID=
ATTENDANCE_SHEET_ID=
ATTENDANCE_SHEET_GID=

# Роли для Excel/fallback-режима; разделитель — точка с запятой.
BARISTA_NAMES=
WAITER_NAMES=

